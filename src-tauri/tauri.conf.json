{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cryptera",
  "version": "2.0.0",
  "identifier": "com.crypto.v2",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../ui"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "msi",
      "nsis"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; connect-src 'none'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    },
    "windows": [
      {
        "title": "Cryptera",
        "width": 1120,
        "height": 740,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ]
  },
  "plugins": {
    "dialog": null
  }
}
