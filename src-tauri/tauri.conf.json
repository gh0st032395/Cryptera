{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CryptoV2",
  "version": "0.1.0",
  "identifier": "com.crypto.v2",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "title": "CryptoV2",
        "width": 1120,
        "height": 740,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ]
  },
  "plugins": {
    "dialog": null
  }
}
